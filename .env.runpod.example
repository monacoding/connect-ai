# RunPod → Connect AI 연결 (이 파일을 .env.runpod 로 복사 후 값 입력)
#
# RunPod 콘솔: Pod 실행 → Connect 탭 → HTTP Services 에서 프록시 URL 복사
# API 키: runpod.io → Settings → API Keys (HTTP 프록시 인증이 필요할 때)

# --- Ollama 템플릿 (포트 11434) ---
RUNPOD_LLM_URL=https://YOUR_POD_ID-11434.proxy.runpod.net
RUNPOD_MODEL=llama3.2
# RUNPOD_ENGINE=ollama

# --- vLLM / Text-Gen / OpenAI 호환 (포트 8000, URL 끝에 /v1 자동 추가) ---
# RUNPOD_LLM_URL=https://YOUR_POD_ID-8000.proxy.runpod.net
# RUNPOD_ENGINE=openai
# RUNPOD_MODEL=meta-llama/Meta-Llama-3-8B-Instruct

# RunPod HTTP 프록시 인증 (필요 시)
# RUNPOD_API_KEY=rpa_xxxxxxxx

# 원격 GPU 응답이 느릴 수 있어 기본 10분
RUNPOD_REQUEST_TIMEOUT=600
